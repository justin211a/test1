# ===========================================
# Marketing Data Pipeline - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Meta (Facebook) Ads ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=["act_XXXXXXXXX"]

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_IDS=["1234567890"]
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Naver Search Ad ---
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_IDS=["12345"]

# --- BigQuery ---
BQ_PROJECT_ID=
BQ_DATASET_ID=marketing_data
BQ_CREDENTIALS_PATH=config/bigquery/service_account.json

# --- Exchange Rate (한국수출입은행) ---
EXCHANGE_RATE_API_KEY=

# --- Slack Webhook ---
SLACK_WEBHOOK_URL=

# --- Email Alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- App ---
TIMEZONE=Asia/Seoul
LOG_LEVEL=INFO
BACKFILL_DAYS=7

# --- Cloud Run Ingest API ---
INGEST_API_KEY=
